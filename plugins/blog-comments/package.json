{
  "name": "@nevitomii/blog-comments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@quartz-community/comments": "^0.1.0",
    "@quartz-community/types": "^0.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "quartz": {
    "name": "blog-comments",
    "displayName": "Blog Comments",
    "category": "component",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "provider": "giscus",
      "options": {}
    },
    "components": {
      "BlogComments": {
        "displayName": "Blog Comments",
        "description": "Giscus comments shown only on notes whose up property points to Blog.",
        "version": "0.1.0",
        "defaultPosition": "afterBody",
        "defaultPriority": 10
      }
    }
  }
}
